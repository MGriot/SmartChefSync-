      "recipe_id": "18ae7228-5fd5-4f9a-9b72-fad444600701",
      "step_number": 3,
      "title": null,
      "description": "Chiudete in una garza la stecca di cannella, le bacche di ginepro, il chiodo di garofano, un cucchiaino di pepe in grani ed un paio di foglie di alloro ed unite questo sacchetto alla carne.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:34",
