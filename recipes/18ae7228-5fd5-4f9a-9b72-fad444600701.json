      "recipe_id": "18ae7228-5fd5-4f9a-9b72-fad444600701",
      "step_number": 1,
      "title": null,
      "description": "Tagliate a pezzi la polpa di cervo e tritatela utilizzando un mixer. Tagliate in piccoli pezzi la cipolla, la carota ed il sedano e rosolateli in una capiente casseruola con 2 cucchiai di olio extravergine.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:34",
