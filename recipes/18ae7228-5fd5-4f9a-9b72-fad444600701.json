      "recipe_id": "18ae7228-5fd5-4f9a-9b72-fad444600701",
      "step_number": 2,
      "title": null,
      "description": "Unite la carne tritata e continuate la cottura per altri 3 minuti, poi aggiungete la polpa di pomodoro, bagnate con circa 300 ml di vino rosso ed una pari quantità di acqua per coprire la carne.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:34",
