      "recipe_id": "789e3c98-6e61-447f-a775-d3d832837628",
      "step_number": 2,
      "title": null,
      "description": "Pesare le farine in un altro recipiente, una volta finito mescolarle leggermente e segnare la metà, fare un segno per dividere la farina nella ciotola in due metà.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:32",
      "technique_ids": "[]"
    },
    {
