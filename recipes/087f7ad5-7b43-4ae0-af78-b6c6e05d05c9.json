  "steps": [
    {
      "id": "7ca68aa0-9171-417b-81b5-dd47cfbd9cad",
      "recipe_id": "087f7ad5-7b43-4ae0-af78-b6c6e05d05c9",
      "step_number": 1,
      "title": null,
      "description": "Per preparare l’hummus per prima cosa scolate e sciacquate i ceci precotti, poi trasferiteli in un mixer. Versate il succo di limone, la tahina e l’olio.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-23 07:11:31",
      "technique_ids": "[]"
    },
    {
      "id": "6a2708db-e5e7-4b0e-9600-95bc7bf6abaf",
      "recipe_id": "087f7ad5-7b43-4ae0-af78-b6c6e05d05c9",
      "step_number": 2,
      "title": null,
      "description": "Unite anche il sale e, se desiderate, uno spicchio di aglio schiacciato e privato dell’anima. Azionate il mixer e frullate regolando la velocità e la durata a seconda del risultato desiderato, che potrà essere più liscio o più rustico. Aggiungete al bisogno 2-3 cucchiai di acqua per raggiungere la consistenza desiderata: al posto dell’acqua potete utilizzare ancora un po’ di succo di limone, per accentuare la nota aspra, oppure di olio o tahina, per un risultato più ricco. Noi abbiamo optato per una crema dalla consistenza burrosa e leggera.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-23 07:11:31",
      "technique_ids": "[]"
    },
    {
      "id": "db4162c9-ecc3-4736-9f77-1d67b535d949",
      "recipe_id": "087f7ad5-7b43-4ae0-af78-b6c6e05d05c9",
      "step_number": 3,
      "title": null,
      "description": "Trasferite l’hummus in una ciotola e guarnite con paprika a piacere, pepe, un filo d’olio e prezzemolo tritato. Il vostro hummus è pronto per essere gustato!",
