    },
    {
      "id": "4570a576-7168-474d-b3c9-45d251cde98e",
      "recipe_id": "feff4a19-55ee-4201-a992-da1abe3eacd7",
      "step_number": 4,
      "title": null,
      "description": "Sciogliere 15 g di burro in un pentolino, aggiungere la farina e cuocere per 2-3 minuti; Aggiungere il latte e portare ad addensamento, quindi stemperare all’interno il Montasio grattugiato e aggiungere anche i porri;",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
