      "step_number": 3,
      "title": null,
      "description": "Rosolare il porro affettato finemente in casseruola con una noce di burro, salare, pepare, quindi tenere da parte una volta morbido;",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-09-06 14:39:02",
