  "steps": [
    {
      "id": "bb6d836d-c812-4515-a219-4471dc30f30c",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 1,
      "title": null,
      "description": "Per realizzare le mini cheesecake per prima cosa occupatevi della base: in un mixer versate i biscotti secchi e frullateli finemente, poi trasferiteli in una ciotola, aggiungete il burro fuso e mescolate con un cucchiaio di legno così da ottenere un composto umido.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    },
    {
      "id": "79242ff6-d880-4308-b485-ac77985dfb3a",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 2,
      "title": null,
      "description": "Adagiate dei coppapasta del diametro di 7,5 cm e con un bordo di 4,5 cm su un vassoio rivestito con carta forno, versate all'interno di ciascuno ¼ delle briciole di biscotto e compattate bene il composto con il dorso del cucchiaio per formare la base. Ponete il tutto a raffreddare in frigorifero per almeno mezz'ora. Ora occupatevi della crema: in una ciotola con acqua fredda ammollate i fogli di gelatina per circa 10 minuti, in modo da ammorbidirli.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    },
    {
      "id": "af221437-a9d4-4682-833a-2e7e07c8a4c2",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 3,
      "title": null,
      "description": "Prendete 50 g di panna dalla dose totale e ponetela in un pentolino a scaldare; una volta che la gelatina si sarà ammorbidita, strizzatela e scioglietela nella panna calda a fuoco spento mescolando con una frusta così non si formeranno i grumi. Lasciate intiepidire appena.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    },
    {
      "id": "66c5e681-9a9d-41c8-bfd0-39ebcabe3afe",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 4,
      "title": null,
      "description": "In una ciotola versate la ricotta, il formaggio spalmabile e lo zucchero a velo, montate con le fruste elettriche per amalgamare e poi aromatizzate con i semi del baccello di vaniglia.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    },
    {
      "id": "83293e3f-2389-4b5d-b5ee-5e104980ac45",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 5,
      "title": null,
      "description": "Versate anche la restante dose di panna e quella nel pentolino, dove avete sciolto la gelatina. Continuate a montare il composto con le fruste fino a quando non sarà morbido e spumoso.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    },
    {
      "id": "f53680a1-63eb-42df-8f4a-9448d42a9ce4",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 6,
      "title": null,
      "description": "Riprendete gli stampini con le basi, riempiteli fino al bordo con la crema, livellando la superficie con il dorso di un cucchiaio. Lasciate rassodare le mini cheesecake per almeno 4 ore in frigorifero.",
      "duration_min": 240,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    },
    {
      "id": "ec9c4ead-238f-4588-a417-2c7a6d1ca1d8",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 7,
      "title": null,
      "description": "Mentre i dolcetti rassodano, preparate la coulis: lavate e asciugate le fragole, quindi tagliatele a pezzi e versatele in un pentolino, aggiungete lo zucchero di canna e cuocete a fuoco basso per 10 minuti; terminata la cottura le fragole saranno morbide. Nel frattempo lasciate ammorbidire la gelatina nell'acqua fredda.",
      "duration_min": 10,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    },
    {
      "id": "719197e8-f4c3-4cae-b9c9-0bdad44c727c",
      "recipe_id": "a96adff3-f87f-47f7-a1bc-6f3743345198",
      "step_number": 8,
      "title": null,
      "description": "Quando le fragole saranno pronte, passatele ancora calde attraverso un colino, pressate con la spatola e raccogliete la purea in una ciotola. Aggiungete la gelatina strizzata e mescolate con la frusta per scioglierla con cura. Riprendete le mini cheesecake rassodate e distribuite nei 4 stampi la coulis. Riponete nuovamente in frigo a rassodare per 1 ora e poi servite le vostre mini cheesecake guarnendole con foglioline di menta fresca e fettine di fragole fresche!",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-21 08:16:22",
      "technique_ids": "[]"
    }
