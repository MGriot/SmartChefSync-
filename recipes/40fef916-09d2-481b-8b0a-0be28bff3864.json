  "steps": [
    {
      "id": "5a9905a9-6e79-4c7c-abeb-ba5967af8e50",
      "recipe_id": "40fef916-09d2-481b-8b0a-0be28bff3864",
      "step_number": 1,
      "title": "Pulizia dei calamari",
      "description": "Lavateli con cura sotto acqua corrente e incidete con un coltellino la parte finale del mantello, quel tanto che basta per prendere un lembo della pelle e tirate via il rivestimento con le mani o aiutandovi con un coltellino. Poi staccate delicatamente la testa dal mantello, estraete la penna di cartilagine, che si trova nel mantello, e le interiora. Prendete la testa estratta e separate i tentacoli.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-09-06 14:36:57",
      "technique_ids": "[]"
    },
    {
      "id": "841785e5-3915-4160-9c09-eb71693cd923",
      "recipe_id": "40fef916-09d2-481b-8b0a-0be28bff3864",
      "step_number": 2,
      "title": "Preparazione del soffritto",
      "description": "Prendete il peperone e dopo averlo mondato e svuotato della parte dura interna con i suoi semini, usatene solo metà. Dividete metà peperone a bastoncini e da questi tagliate dei cubetti. Quindi sbucciate uno spicchio d’aglio e privatelo del suo germe interno, versate 2 cucchiai d’olio extravergine di oliva in una padella antiaderente e fate dorare l’aglio. Aggiungete poi il cipollotto tagliato finemente e fate rosolare.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-09-06 14:36:57",
      "technique_ids": "[]"
    },
    {
      "id": "9dce188e-c6b8-4f5b-83ba-155087910a60",
      "recipe_id": "40fef916-09d2-481b-8b0a-0be28bff3864",
      "step_number": 3,
      "title": "Preparazione del ripieno",
      "description": "Tritate i tentacoli e metteteli da parte in una ciotolina. Lavate le verdure con cura. Prendete la carota, pelatela e dopo averla tagliata per il lungo, formate dei dadini. Mondate la zucchina, dividetela a metà e tagliatela a dadini. Sbucciate il cipollotto fresco, mondatelo e affettatolo. Tenete presente che tutte le verdure devono essere tagliate a piccoli pezzi, che andranno a costituire parte del ripieno dei calamari.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-09-06 14:36:57",
      "technique_ids": "[]"
    },
    {
      "id": "15fb61e8-be5c-4f2e-88c8-f1e2abd83ced",
      "recipe_id": "40fef916-09d2-481b-8b0a-0be28bff3864",
      "step_number": 4,
      "title": "Preparazione del couscous",
      "description": "Versare il couscous in una ciotola. Salatelo, conditelo con un filo d’olio e versate la stessa quantità di acqua bollente. Coprire la ciotola con la pellicola e lasciate riposare fino a quando il couscous non si sarà gonfiato, raddoppiando la sua dose.",
      "duration_min": 5,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-09-06 14:36:57",
      "technique_ids": "[]"
    },
    {
      "id": "ac8b71b9-f4ed-4c86-80fe-37db5e7a2777",
      "recipe_id": "40fef916-09d2-481b-8b0a-0be28bff3864",
      "step_number": 5,
      "title": "Cottura dei calamari",
      "description": "Saltate i calamari in padella sfumandoli con il vino bianco.  Non fateli cuocere per troppo tempo, perché diventerebbero gommosi, e assaporateli subito prima che si induriscano.",
