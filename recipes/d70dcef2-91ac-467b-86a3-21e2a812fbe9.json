    {
      "id": "619905fd-2f04-4408-b581-2bbf9e753e44",
      "recipe_id": "d70dcef2-91ac-467b-86a3-21e2a812fbe9",
      "step_number": 2,
      "title": null,
      "description": "2) Il giorno dopo scola la carne dalla marinata e asciugala con un canovaccio. Pela e affetta a fettine sottili la cipolla; lavale, mondale e tritale finemente con una manciata di foglie di prezzemolo.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-23 07:10:05",
