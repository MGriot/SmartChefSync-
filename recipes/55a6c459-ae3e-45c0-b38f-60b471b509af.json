  "steps": [
    {
      "id": "0b969c19-d5f7-4aaa-8ea4-b54cd135c4b9",
      "recipe_id": "55a6c459-ae3e-45c0-b38f-60b471b509af",
      "step_number": 1,
      "title": null,
      "description": "Infarinare i cubetti di carne.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:35",
      "technique_ids": "[]"
    },
    {
      "id": "23fac631-7e22-48f7-8a99-d3d9f3d6bd55",
      "recipe_id": "55a6c459-ae3e-45c0-b38f-60b471b509af",
      "step_number": 2,
      "title": null,
      "description": "In una cocotte dal fondo spesso, scaldare l'olio a fuoco medio-vivo e rosolare i pezzi di carne, una piccola quantità alla volta. Girare i pezzi e cuocere per 5-7 minuti fino a quando saranno ben dorati uniformemente. Tirar fuori i cubetti dalla cocotte con una schiumarola o un cucchiaio con fori, salare e trasferire in un piatto.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:35",
      "technique_ids": "[]"
    },
    {
      "id": "662e7ae0-cb7b-4035-bb5c-d801104c2296",
      "recipe_id": "55a6c459-ae3e-45c0-b38f-60b471b509af",
      "step_number": 3,
      "title": null,
      "description": "Nella cocotte aggiungere la cipolla, la carota e il sedano, dunque, cuocere rimescolando per circa 5 minuti o fino a quando si saranno inteneriti. Aggiungere l'aglio e cuocere per 1 minuto mescolando. Aggiungere il concentrato di pomodoro e il Cognac. Lasciare bollire fino a quando quest'ultimo sarà del tutto evaporato. Aggiungere il vino rosso e lasciare bollire fino a quando il liquido si riduce della metà circa.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:35",
      "technique_ids": "[]"
    },
    {
      "id": "2c455bc3-7456-4534-9781-585b5c17fe36",
      "recipe_id": "55a6c459-ae3e-45c0-b38f-60b471b509af",
      "step_number": 4,
      "title": null,
      "description": "Rimettere i cubetti di cervo nella cocotte e aggiungere il brodo (quanto basta per coprire). Aggiungere le foglie di alloro, i chiodi di garofano, le erbe di Provenza e il pepe in grani.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:35",
      "technique_ids": "[]"
    },
    {
      "id": "38424641-e4f6-4edb-9234-0fffbcc928fb",
      "recipe_id": "55a6c459-ae3e-45c0-b38f-60b471b509af",
      "step_number": 5,
      "title": null,
      "description": "Abbassare la fiamma, coprire e lasciare sobbollire per 1 ora e 30 minuti o fino a quando la carne sarà tenera. Aggiungere del brodo per diluire la salsa se è di gradimento.",
      "duration_min": null,
      "tool_ids": "[]",
      "notes": null,
      "image_url": null,
      "step_ingredients": "[]",
      "created_at": "2026-08-20 12:28:35",
      "technique_ids": "[]"
    },
    {
      "id": "e1983680-ad35-49dd-bbf8-a40bf4e27f46",
      "recipe_id": "55a6c459-ae3e-45c0-b38f-60b471b509af",
      "step_number": 6,
      "title": null,
      "description": "Togliere le foglie di alloro e aggiustare di condimento. Servire nei piatti caldi.",
